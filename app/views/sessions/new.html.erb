


<div class="login-container">
  <div class="login-card">
    <h1 class="login-title">
      <span class="icon">🎧</span>
      Welcome Back to <span class="highlight">VinylVerse</span>
    </h1>

    <%= form_with url: login_path, method: :post, local: true do |form| %>
      <div class="input-group">
        <%= form.label :email, "Email", class: "input-label" %>
        <%= form.email_field :email, class: "input-field" %>
      </div>

      <div class="input-group">
        <%= form.label :password, "Password", class: "input-label" %>
        <%= form.password_field :password, class: "input-field" %>
      </div>

      <%= form.submit "Login", class: "btn-login" %>
    <% end %>

    <p class="back-link">
      ← <%= link_to "Back to Collection", collection_path, class: "back-link" %>
    </p>
  </div>
</div>
