<div class="container mt-5 d-flex justify-content-center align-items-center" style="min-height: 80vh;">
  <div class="card shadow p-4" style="width: 400px;">
    <h3 class="text-center mb-4">
      🎵 <strong>Login to VinylVerse</strong>
    </h3>

    <%= form_with url: "/login", method: :post, local: true do |f| %>
      <div class="form-group mb-3">
        <%= f.label :email, "Email", class: "form-label fw-bold" %>
        <%= f.text_field :email, class: "form-control", placeholder: "Enter your email" %>
      </div>

      <div class="form-group mb-3">
        <%= f.label :password, "Password", class: "form-label fw-bold" %>
        <%= f.password_field :password, class: "form-control", placeholder: "Enter your password" %>
      </div>

      <div class="d-grid">
        <%= f.submit "Login", class: "btn btn-success" %>
      </div>
    <% end %>
  </div>
</div>
