<p style="color: green"><%= notice %></p>

<h2><%= @artist.name %></h2>

<p><strong>Genre:</strong> <%= @discogs_genre || "-" %></p>
<p><strong>Country:</strong> <%= @discogs_country || "-" %></p>
<p><strong>Releases on Discogs:</strong> <%= (@discogs_releases_count || 0) %></p>

<hr>
<h3>In Your Collection</h3>
<% if (@collection_albums || []).any? %>
  <ul>
    <% @collection_albums.each do |a| %>
      <li><%= a.title %></li>
    <% end %>
  </ul>
<% else %>
  <p>None yet.</p>
<% end %>

<h3>In Your Wishlist</h3>
<% if (@wishlist_albums || []).any? %>
  <ul>
    <% @wishlist_albums.each do |a| %>
      <li><%= a.title %></li>
    <% end %>
  </ul>
<% else %>
  <p>None yet.</p>
<% end %>

<div>
  <%= link_to "Edit this artist", edit_artist_path(@artist) %> |
  <%= link_to "Back to artists", artists_path %>

  <%= button_to "Destroy this artist", @artist, method: :delete %>
</div>
