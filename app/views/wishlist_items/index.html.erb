<div class="wishlist-page py-5">
  <h1 class="text-center mb-4">🎧 My Wishlist</h1>
  <p class="text-center text-muted mb-5">Albums I want to add to my collection</p>

  <div class="wishlist-container" style="max-width: 1200px; margin: 0 auto;">
    <% if @wishlist_items.present? %>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;">
        <% @wishlist_items.each do |item| %>
          <div class="wishlist-card" style="border: 1px solid #ddd; padding: 15px; border-radius: 8px; background: white;">
            <% if item.image_url.present? %>
              <img src="<%= item.image_url %>" alt="<%= item.title %>" style="width: 100%; height: auto; margin-bottom: 10px; border-radius: 4px;">
            <% else %>
              <div style="width: 100%; height: 250px; background: #e0e0e0; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; border-radius: 4px;">
                <span style="color: #999; font-size: 48px;">🎵</span>
              </div>
            <% end %>
            
            <h3 style="font-size: 18px; margin-bottom: 10px;"><%= item.title %></h3>
            <p><strong>Artist:</strong> <%= item.artist || "Unknown Artist" %></p>
            
            <div style="margin-top: 15px;">
              <%= button_to 'Remove from Wishlist', wishlist_item_path(item), method: :delete, class: "btn btn-outline-danger btn-sm", data: { confirm: "Remove #{item.title} from wishlist?" } %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center">
        <p class="text-muted mb-4">Your wishlist is empty 💜</p>
        <p><%= link_to "Search for albums to add", search_path, class: "btn btn-primary" %></p>
      </div>
    <% end %>
  </div>
</div>