<!-- app/views/layouts/application.html.erb -->
<!DOCTYPE html>
<html>
  <head>
    <title>VinylVerse</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="display: flex; flex-direction: column; min-height: 100vh; margin: 0;">
    <!-- Only show header if user is logged in and not on login/signup pages -->
    <% unless controller_name == 'sessions' && action_name == 'new' || controller_name == 'users' && action_name == 'new' %>
      <% if logged_in? %>
        <%= render 'shared/header' %>
      <% end %>
    <% end %>

    <!-- Flash messages -->
    <% if notice %>
      <div style="background: #d1fae5; color: #065f46; padding: 12px 20px; text-align: center;">
        <%= notice %>
      </div>
    <% end %>
    
    <% if alert %>
      <div style="background: #fee2e2; color: #991b1b; padding: 12px 20px; text-align: center;">
        <%= alert %>
      </div>
    <% end %>

    <!-- Main content -->
    <main style="flex: 1;">
      <%= yield %>
    </main>

    <!-- Footer -->
    <%= render 'shared/footer' %>
  </body>
</html>